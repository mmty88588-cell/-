<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.blog.mapper.TagMapper">

    <resultMap id="tagMap" type="com.blog.entity.Tag">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="selectAll" resultMap="tagMap">
        SELECT * FROM tag ORDER BY id ASC
    </select>

    <select id="selectByArticleId" resultMap="tagMap">
        SELECT t.* FROM tag t
        INNER JOIN article_tag at ON t.id = at.tag_id
        WHERE at.article_id = #{articleId}
    </select>

    <select id="selectById" resultMap="tagMap">
        SELECT * FROM tag WHERE id = #{id}
    </select>

    <select id="selectByName" resultMap="tagMap">
        SELECT * FROM tag WHERE name = #{name}
    </select>

    <insert id="insert" parameterType="com.blog.entity.Tag" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tag (name) VALUES (#{name})
    </insert>

    <delete id="deleteById">
        DELETE FROM tag WHERE id = #{id}
    </delete>

</mapper>
